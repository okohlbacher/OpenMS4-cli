@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(OpenMS @OpenMS_VERSION@ EXACT CONFIG)
if(NOT OpenMS_SOURCE_REVISION STREQUAL "@OpenMS_SOURCE_REVISION@")
  message(FATAL_ERROR "OpenMSCLI requires OpenMS core commit @OpenMS_SOURCE_REVISION@")
endif()
set(OpenMSCLI_VERSION "@OpenMSCLI_VERSION@")
set(OpenMSCLI_SOURCE_REVISION "@OpenMSCLI_SOURCE_REVISION@")
include("${CMAKE_CURRENT_LIST_DIR}/OpenMSCLITargets.cmake")
check_required_components(OpenMSCLI)

set(OpenMSCLI_SOURCE_DIRTY "@OpenMSCLI_SOURCE_DIRTY@")
